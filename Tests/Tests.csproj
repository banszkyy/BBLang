<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <StartupObject>LanguageCore.Tests.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.7.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.2.3" />
    <PackageReference Include="MSTest.TestFramework" Version="4.2.3" />
    <PackageReference Include="ReportGenerator.Core" Version="5.5.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Examples/Examples.csproj" />
    <ProjectReference Include="../Source/Core.csproj">
      <SetConfiguration>ForTesting=true</SetConfiguration>
    </ProjectReference>
    <ProjectReference Include="../Utility/Utility.csproj" />
  </ItemGroup>
</Project>